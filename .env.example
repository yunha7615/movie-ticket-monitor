# Kakao Developers > 앱 > 플랫폼 키 > REST API 키
KAKAO_REST_API_KEY=

# 신규 앱은 클라이언트 시크릿이 기본 활성화됩니다.
KAKAO_CLIENT_SECRET=

# Kakao Developers에 같은 URI를 등록하세요.
KAKAO_REDIRECT_URI=http://localhost:8787/callback

# 자동 탐색이 실패할 때만 설정합니다.
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
